# Dependencies & installs
node_modules/
.pnp
.pnp.js

# Build / deploy worktrees
build/
.deploy/
coverage/

# Godot export binaries (huge; never useful as text context)
public/index.wasm
public/index.pck
public/index.js
public/*.import

# Large media (use @path only when editing these)
**/*.mp4
**/*.mp3
**/*.wav
**/*.webm

# Logs & env
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Lockfile dumps rarely help agents; keep package.json as source of truth
package-lock.json
